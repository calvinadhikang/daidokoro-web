<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="MENU_IMAGE_DISK" value="public"/>
        <env name="MANJO_BASE_URL" value="https://snap-uat.manjo.co.id/api"/>
        <env name="MANJO_CLIENT_ID" value="test-client"/>
        <env name="MANJO_CLIENT_SECRET" value="test-secret"/>
        <env name="MANJO_MERCHANT_ID" value="MTTEST"/>
        <env name="MANJO_PARTNER_ID" value="MTTEST"/>
        <env name="MANJO_CHANNEL_ID" value="05"/>
        <env name="MANJO_PRIVATE_KEY_PATH" value=""/>
        <env name="MANJO_PROVIDER_PUBLIC_KEY_PATH" value=""/>
        <env name="MANJO_CLIENT_IP" value="127.0.0.1"/>
        <env name="MANJO_ORIGIN" value="staging.daidokoro.my.id"/>
        <env name="MANJO_QR_VALIDITY_SECONDS" value="3600"/>
        <env name="MANJO_NOTIFY_PATH" value="/api/manjo/qris/notify"/>
        <env name="MANJO_QRIS_ENABLED" value="true"/>
    </php>
</phpunit>
